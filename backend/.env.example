# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Aplicación
APP_NAME=FrioTrack API
# `local` para desarrollo. En Render debe ser ENTORNO=produccion, junto con un
# JWT_SECRET fuerte de 32 caracteres o más; la API no arranca si no cumple.
# Render define RENDER=true, que también cuenta como producción (ver app/config.py).
ENTORNO=local
ESCALA_TIEMPO=1

# Base de datos (Supabase → Project Settings → Database)
# Copia aquí la URI "Session Pooler" (incluye el usuario postgres.<project-ref>).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Autenticación
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRA_HORAS=8
CRON_TOKEN=token-cron-de-ejemplo
# Tokens de los sensores en claro SOLO para sembrar la primera vez (la rotación
# no está implementada en el Alfa): la API y la base guardan únicamente su
# SHA-256 (ver docs/modelo-datos.md) y la autenticación compara el hash. No los
# reutilices como secretos de producción.
SENSOR_TOKENS='{"S-PES-01":"token-pes-ejemplo","S-CAR-01":"token-car-ejemplo","S-LAC-01":"token-lac-ejemplo","S-VER-01":"token-ver-ejemplo","S-CON-01":"token-con-ejemplo"}'
# Contraseña inicial de los usuarios semilla `jefe` y `gerente`; obligatoria para cargar el seed.
SEED_PASSWORD=friotrack-demo

# CORS: orígenes separados por comas
CORS_ORIGINS=*

# Twilio (SMS de alertas)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=token-twilio-de-ejemplo
TWILIO_FROM=+5215500000000
TELEFONO_JEFE=+5215512345678

# Dashboard
DASHBOARD_URL=http://localhost:5173
