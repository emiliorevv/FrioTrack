# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Aplicación
APP_NAME=FrioTrack API
ESCALA_TIEMPO=1

# Base de datos (desarrollo con SQLite; producción con el Postgres de Supabase)
DATABASE_URL=sqlite:///./friotrack.db

# Autenticación
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRA_HORAS=8
CRON_TOKEN=token-cron-de-ejemplo
SENSOR_TOKENS='{"S-PES-01":"token-ejemplo"}'

# CORS: orígenes separados por comas
CORS_ORIGINS=*

# Twilio (SMS de alertas)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=token-twilio-de-ejemplo
TWILIO_FROM=+5215500000000
TELEFONO_JEFE=+5215512345678

# Dashboard
DASHBOARD_URL=http://localhost:5173
